# ==========================================
# DaeReview Environment Variables Template
# Salin file ini menjadi .env.local untuk penggunaan lokal
# JANGAN PERNAH commit file .env.local ke Git repository!
# ==========================================

# Supabase PostgreSQL & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Admin Security & Server Authentication
# Password admin untuk membuka dashboard /admin
ADMIN_SECRET_KEY=your_super_secret_admin_password_here
ADMIN_SALT_SECRET=your_random_salt_string_for_hmac_here

# Dify AI Autonomous Agent Webhook Secret Key
# Token otorisasi untuk API publikasi otomatis Dify Agent (/api/dify/publish)
DIFY_WEBHOOK_SECRET=your_dify_webhook_bearer_token_here

# Production Domain & SEO Canonical Base URL
NEXT_PUBLIC_SITE_URL=https://daereview.daeroom.my.id
